{
  "name": "prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:permissions": "node --test tests/permission-rules.test.mjs",
    "test:nfc": "node --test tests/nfc-tags.test.mjs",
    "test:templates": "node --test tests/inspection-templates.test.mjs",
    "test:plans": "node --test tests/plan-rules.test.mjs",
    "test:inspections": "node --test tests/inspection-rules.test.mjs",
    "test:events": "node --test tests/event-rules.test.mjs",
    "test:works": "node --test tests/work-rules.test.mjs",
    "test:grids": "node --test tests/grid-rules.test.mjs",
    "test:objects": "node --test tests/object-rules.test.mjs",
    "test:types": "node --test tests/inspection-type-rules.test.mjs",
    "test:items": "node --test tests/item-rules.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@vitejs/plugin-react": "5.0.4",
    "antd-mobile": "^5.43.0",
    "antd-mobile-icons": "^0.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.5.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
